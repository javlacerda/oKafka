Do ivLstMessagesOcc.$clear()
Redraw cgMessagesOcc

Do method CreateRowParam (lvRowParam)

Do ivoKafkaJava.$callmethod("com.omnis.kafka.OKafkaConsumer","connect",lvRowParam) Returns lvbOk
If not(lvbOk)
	Do $cwind.$showmessage(con("Java Worker Error: ",ivoKafkaJava.$GetErrorMessage()))
	Quit method
End If
If ivbSuccess
	Calculate ivbConsumerOpen as kTrue
	Do method DefBtnsConsumeOcc
End If
Quit method