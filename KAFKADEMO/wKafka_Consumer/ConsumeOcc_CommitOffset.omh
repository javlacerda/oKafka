If ivLstMessagesOcc.$linecount=0
	Do $cwind.$showmessage("No messages!","Error",kMsgOK+kMsgIcon)
	Quit method
End If

Calculate lvnLastLine as ivLstMessagesOcc.$linecount

Do $cwind.$showmessage(con("Commit offset ",ivLstMessagesOcc.[lvnLastLine].offset,"?"),"Confirmation",kMsgNoYes+kMsgIcon) Returns lvbOk
If not(lvbOk)
	Quit method
End If

If ivnType=ucKafka.PYTHON_OW
	Do method ConsumeOcc_CommitOffset_Python (ivLstMessagesOcc.[lvnLastLine].offset,ivLstMessagesOcc.[lvnLastLine].partition) Returns lvbOk
Else If ivnType=ucKafka.JAVA_OW
	Do method ConsumeOcc_CommitOffset_Java (ivLstMessagesOcc.[lvnLastLine].offset,ivLstMessagesOcc.[lvnLastLine].partition) Returns lvbOk
Else
	Do method ConsumeOcc_CommitOffset_xcomp (ivLstMessagesOcc.[lvnLastLine].offset,ivLstMessagesOcc.[lvnLastLine].partition) Returns lvbOk
End If
If lvbOk
	Do $cwind.$showmessage("Offset commited!","Info",kMsgIcon)
End If
Quit method