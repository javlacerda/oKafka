Do ivLstMessages.$clear()
Redraw cgMessages

Do lvLstHeaders.$copydefinition(ivLstHeaders)

Do lvoConsumer.$setbroker(ivcServer)
Do lvoConsumer.$settopic(ivcTopic)
Do lvoConsumer.$setgroupid(ivcGroupId)
Do lvoConsumer.$setclientid(ivcClientId)
Do lvoConsumer.$settimeout(ivnTimeout)
If ivbForcePartition
	Do lvoConsumer.$setpartition(ivnPartition)
End If

For lvnLoop from 1 to ivLstConfig.$linecount step 1
	Do lvoConsumer.$setproperty(ivLstConfig.[lvnLoop].C1,ivLstConfig.[lvnLoop].C2)
End For

Do lvoConsumer.$connect() Returns lvbOk
If not(lvbOk)
	Do $cwind.$showmessage(lvoConsumer.$geterrormessage(),"Error")
	Quit method
End If

For lvnLoop from 1 to ivnQuantity step 1
	Do lvoConsumer.$consume(1,ivnTimeout*1000,lvLstRegs) Returns lvbOk
	If lvbOk
		If lvLstRegs.$linecount>0
			Calculate lvLstRegs.$line as lvLstRegs.$linecount
			Do ivRowResult.$copydefinition(lvLstRegs)
			Do ivRowResult.$assignrow(lvLstRegs)
			
			Do ivLstMessages.$add()
			Calculate ivLstMessages.$line as ivLstMessages.$linecount
			Calculate ivLstMessages.Offset as ivRowResult.Offset
			Calculate ivLstMessages.Partition as ivRowResult.Partition
			Calculate ivLstMessages.Topic as ivRowResult.Topic
			Calculate ivLstMessages.Key as ivRowResult.Key
			Calculate ivLstMessages.Timestamp as ivRowResult.Timestamp
			Calculate ivLstMessages.Message as ivRowResult.Message
			
			Do lvLstHeaders.$clear()
			Do method FillLstHeaders (lvLstHeaders)
			Calculate ivLstMessages.Headers as lvLstHeaders
		Else
			Do $cwind.$showmessage("No messages in the queue!//Do you want to continue?","Info",kMsgNoYes) Returns lvbOk
			If not(lvbOk)
				Break to end of loop
			End If
		End If
	Else
		Break to end of loop
	End If
End For

Redraw (Refresh now) cgMessages

Do lvoConsumer.$disconnect()
Quit method