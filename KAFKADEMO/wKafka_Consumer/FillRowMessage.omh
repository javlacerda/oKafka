Calculate ivRowMessage.Offset as ivRowResult.Offset
Calculate ivRowMessage.Partition as ivRowResult.Partition
Calculate ivRowMessage.Topic as ivRowResult.Topic
Calculate ivRowMessage.Key as ivRowResult.Key
Calculate ivRowMessage.Timestamp as ivRowResult.Timestamp
If ivnType=ucKafka.PYTHON_OW|ivnType=ucKafka.JAVA_OW
	Calculate ivRowMessage.Message as ivRowResult.Value
Else
	Calculate ivRowMessage.Message as ivRowResult.Message
End If

Do method FillLstHeaders (ivLstHeaders)
Quit method