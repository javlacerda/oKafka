Do ivLstTopics.$clear()

Do lvoHttp.$SetHost(ivcServer)
Do lvoHttp.$SetUri("/topics")

Do lvoHttp.$HttpGet() Returns lvbOk
Do lvoHttp.$GetResponseContent() Returns lvcResponse

If not(lvbOk)
	Do $cwind.$showmessage(lvoHttp.$GetMsgErro(),"Error")
	Quit method kFalse
End If

Do OJSON.$jsontolistorrow(lvcResponse,lvcErrorMsg,kTrue) Returns lvLstResponse
If isnull(lvLstResponse)
	Do $cwind.$showmessage(lvcErrorMsg,"Error")
	Quit method kFalse
End If

Do lvLstResponse.$sendall(ivLstTopics.$add($sendallref.C1))
Do ivLstTopics.$sort($ref.C1)
Redraw (Refresh now) hlbTopics
Quit method