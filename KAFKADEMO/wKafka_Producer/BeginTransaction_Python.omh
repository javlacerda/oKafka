Do lvRowParam.$define()
Do lvRowParam.$cols.$add("TransactionalId",kCharacter,kSimplechar)
Calculate lvRowParam.TransactionalId as con("tr_",#CT)

Do ivoKafkaPython.$callmethod("okafka","set_transactional_id",lvRowParam) Returns lvbOk
If not(lvbOk)
	Do $cwind.$showmessage(con("Python Worker Error: ",ivoKafkaPython.$GetErrorMessage()))
	Quit method kFalse
End If
If not(ivbSuccess)
	Quit method kFalse
End If

Do method DefineRowParam (lvRowParam)

Do ivoKafkaPython.$callmethod("okafka","connect_producer",lvRowParam) Returns lvbOk
If not(lvbOk)
	Do $cwind.$showmessage(con("Python Worker Error: ",ivoKafkaPython.$GetErrorMessage()))
	Quit method kFalse
End If
If not(ivbSuccess)
	Quit method kFalse
End If

Do lvRowParam.$define()

Do ivoKafkaPython.$callmethod("okafka","begin_transaction",lvRowParam) Returns lvbOk
If not(lvbOk)
	Do $cwind.$showmessage(con("Python Worker Error: ",ivoKafkaPython.$GetErrorMessage()))
	Quit method kFalse
End If
Quit method kTrue