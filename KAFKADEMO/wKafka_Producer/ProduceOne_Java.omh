Do method DefineRowParam (lvRowParam)

Do ivoKafkaJava.$callmethod("com.omnis.kafka.OKafkaProducer","connect",lvRowParam) Returns lvbOk
If not(lvbOk)
	Do $cwind.$showmessage(con("Java Worker Error: ",ivoKafkaJava.$GetErrorMessage()))
	Quit method
End If
If not(ivbSuccess)
	Quit method
End If

Do ivoKafkaJava.$callmethod("com.omnis.kafka.OKafkaProducer","produce",lvRowParam) Returns lvbOk
If not(lvbOk)
	Do $cwind.$showmessage(con("Java Worker Error: ",ivoKafkaJava.$GetErrorMessage()))
Else
	If ivRowResult.Success
		Do $cwind.$showmessage(con("Success!// //Offset: ",ivRowResult.Offset,"//Partition: ",ivRowResult.Partition,"//Timestamp: ",ivRowResult.Timestamp),"Info",kMsgIcon)
	End If
End If

Do ivoKafkaJava.$callmethod("com.omnis.kafka.OKafkaProducer","close",lvRowParam) Returns lvbOk
If not(lvbOk)
	Do $cwind.$showmessage(con("Java Worker Error: ",ivoKafkaJava.$GetErrorMessage()))
End If
Quit method