Do method DefineRowParam (lvRowParam)

Do ivoKafkaPython.$callmethod("okafka","connect_producer",lvRowParam) Returns lvbOk
If not(lvbOk)
	Do $cwind.$showmessage(con("Python Worker Error: ",ivoKafkaPython.$GetErrorMessage()))
	Quit method
End If
If not(ivbSuccess)
	Quit method
End If

Do ivoKafkaPython.$callmethod("okafka","produce",lvRowParam) Returns lvbOk
If not(lvbOk)
	Do $cwind.$showmessage(con("Python Worker Error: ",ivoKafkaPython.$GetErrorMessage()))
Else
	If ivRowResult.Success
		Do $cwind.$showmessage(con("Success!// //Offset: ",ivRowResult.Offset,"//Partition: ",ivRowResult.Partition,"//Timestamp: ",ivRowResult.Timestamp),"Info",kMsgIcon)
	End If
End If

Do lvRowParam.$define()
Do ivoKafkaPython.$callmethod("okafka","close_producer",lvRowParam) Returns lvbOk
If not(lvbOk)
	Do $cwind.$showmessage(con("Python Worker Error: ",ivoKafkaPython.$GetErrorMessage()))
End If
Quit method