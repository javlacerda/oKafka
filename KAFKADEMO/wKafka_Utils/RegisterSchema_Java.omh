Do lvRowParam.$define()
Do lvRowParam.$cols.$add("SchemaRegistryUrl",kCharacter,kSimplechar)
Do lvRowParam.$cols.$add("Schema",kCharacter,kSimplechar)
Do lvRowParam.$cols.$add("Subject",kCharacter,kSimplechar)

Calculate lvRowParam.SchemaRegistryUrl as ivcSchemaRegistryUrl
Calculate lvRowParam.Schema as ivcSchemaStr
Calculate lvRowParam.Subject as ivcSubjectRegisterSchema

Do ivoKafkaJava.$callmethod("com.omnis.kafka.OSchemaUtils","registerSchema",lvRowParam) Returns lvbOk
If not(lvbOk)
	Do $ctask.$showmessage(con("Java Worker Error: ",ivoKafkaJava.$GetErrorMessage()))
Else
	If ivRowResult.Success
		Do $cinst.$showmessage(con("Schema ID: ",ivRowResult.SchemaId),"Info")
	End If
End If
Quit method