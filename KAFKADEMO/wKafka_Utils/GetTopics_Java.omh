Do ivLstTopics.$clear()
Do lvRowParam.$define()
Do lvRowParam.$cols.$add("Server",kCharacter,kSimplechar)
Do lvRowParam.$cols.$add("Timeout",kInteger,k32bitint)
Do lvRowParam.$cols.$add("ListInternal",kBoolean)
Do lvRowParam.$cols.$add("Config",kList)

Calculate lvRowParam.Server as ivcServer
Calculate lvRowParam.Timeout as ivnTimeout
Calculate lvRowParam.ListInternal as kTrue
Calculate lvRowParam.Config as ivLstConfig

Do ivoKafkaJava.$callmethod("com.omnis.kafka.OKafkaUtils","getTopics",lvRowParam) Returns lvbOk
If not(lvbOk)
	Do $ctask.$showmessage(con("Java Worker Error ",ivoKafkaJava.$GetErrorMessage()))
Else
	If ivRowResult.Success
		Set reference lvRefLst to ivRowResult.Topics
		If not(isclear(lvRefLst))
			For lvRefLst.$line from 1 to lvRefLst.$linecount step 1
				Do ivLstTopics.$add(lvRefLst.C1)
			End For
		End If
		
		Do ivLstTopics.$sort($ref.Name,kFalse)
	End If
	
	Do $cwind.$showmessage(con(ivLstTopics.$linecount," topics retrieved!"),"Info",kMsgIcon)
End If

Redraw (Refresh now) hlbTopics
Quit method